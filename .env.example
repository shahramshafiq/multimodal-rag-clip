# Copy this file to .env. Only OPENAI_API_KEY is private. Every other value can stay as it is.
OPENAI_API_KEY=

# ------------------------------------------------------------------ models
CLIP_MODEL=openai/clip-vit-base-patch32
TEXT_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4.1-mini
# low, medium or high for models that reason before answering. Empty for models that do not take it.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# high lets the model read small numbers on a chart. It costs more than low.
IMAGE_DETAIL=high
ANSWER_MAX_TOKENS=1500

# ------------------------------------------------------------------ files
PDF_DIR=data/pdfs
INDEX_DIR=data/index
FIGURE_DIR=data/figures
# One description per figure, written once by the vision model and only used to find the figure.
DESCRIPTIONS_FILE=data/figure_descriptions.json
GOLDEN_FILE=eval/golden.json
RESULTS_DIR=eval/results

# ------------------------------------------------------------------ extraction
# Text after a heading with this name is dropped, on that page and all later pages.
STOP_HEADINGS=References
# Text blocks shorter than this are dropped (page numbers and running headers).
MIN_BLOCK_CHARS=40
# A vector shape or image smaller than this (in points, each side) is not part of a figure.
MIN_FIGURE_PART_SIZE=40
# Figure parts closer than this (in points) to the figure being built join it.
FIGURE_MERGE_GAP=40
# A figure must start within this distance (in points) of its caption.
FIGURE_CAPTION_GAP=60
FIGURE_DPI=170

# ------------------------------------------------------------------ chunking
# Counted with the CLIP tokenizer, which is close enough for the text embedding model.
# Measured, right page within the top 6 chunks: 70 tokens missed 1 question, 120 tokens missed none.
CHUNK_MAX_TOKENS=120

# ------------------------------------------------------------------ retrieval
# How many chunks are searched for. The model then reads the whole page of each one.
TOP_K_TEXT=6
TOP_K_FIGURES=2
# image: CLIP compares the question with the picture. description: text search over the figure's description.
# both: the two rankings are combined with reciprocal rank fusion.
# Measured on the natural questions, right figure in the top 1 / top 2: image 4/8, description 11/13, both 5/13 (out of 14).
FIGURE_SEARCH=description
RRF_K=60

# ------------------------------------------------------------------ answering
NOT_FOUND_SENTENCE=I could not find this in the documents.
